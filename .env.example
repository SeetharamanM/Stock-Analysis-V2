# ---------------------------------------------------------------------------
# LLM provider selection
#
# The provider and model are picked from dropdowns in the web UI. LLM_PROVIDER
# only sets which provider is selected when the page first opens.
#   anthropic  — native Claude API (tool use + prompt caching, full-length reports)
#   openrouter — any model on OpenRouter (OpenAI-compatible)
#   deepseek   — DeepSeek API (OpenAI-compatible; 8K output cap → long reports may truncate)
# ---------------------------------------------------------------------------
LLM_PROVIDER=anthropic

# Optional: pin the model for the LLM_PROVIDER provider above (the UI model
# dropdown is then locked for that provider only). Leave blank to pick in the UI.
#   anthropic  e.g.  claude-sonnet-5   claude-opus-4-8
#   openrouter e.g.  deepseek/deepseek-chat   anthropic/claude-sonnet-4   openai/gpt-4o
#   deepseek   e.g.  deepseek-v4-pro   deepseek-v4-flash
LLM_MODEL=

# Optional overrides (usually leave blank):
# LLM_MAX_TOKENS=32000
# LLM_BASE_URL=

# ---------------------------------------------------------------------------
# API keys — add one for each provider you want to pick in the UI.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=your-anthropic-api-key-here
# OPENROUTER_API_KEY=sk-or-your-key-here
# DEEPSEEK_API_KEY=sk-your-deepseek-key-here
