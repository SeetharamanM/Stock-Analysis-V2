# Copy to .streamlit/secrets.toml for local runs, or paste into
# Streamlit Cloud -> your app -> Settings -> Secrets. Never commit real keys.

# Add a key for each provider you want to use.
ANTHROPIC_API_KEY = "sk-ant-..."
# DEEPSEEK_API_KEY = "sk-..."
# OPENROUTER_API_KEY = "sk-or-..."

# Provider selected when the app opens: anthropic | deepseek | openrouter
LLM_PROVIDER = "anthropic"

# Strongly recommended for a deployed app: anyone with the URL could
# otherwise spend your API credit.
APP_PASSWORD = "choose-a-password"
